# Public — shipped to the browser.
PUBLIC_NEAR_NETWORK=testnet
PUBLIC_NEAR_RPC_URL=
PUBLIC_GAME_CONTRACT=jg-game-5656.testnet
PUBLIC_STAKE_CONTRACT=jg-stake-5656.testnet
PUBLIC_MINT_PRICE_NEAR=2

# Private — server only. Leave empty and the AI endpoints report themselves as
# unconfigured; nothing else in the app depends on them.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
