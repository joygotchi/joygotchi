{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JOYGOTCHI",
  "version": "0.1.1",
  "identifier": "dev.joygotchi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5290",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "JOYGOTCHI",
        "width": 260,
        "height": 300,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.joygotchi/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
