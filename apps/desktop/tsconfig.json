{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "*.ts"
  ],
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "allowJs": true,
    "moduleDetection": "force",
    "types": [
      "svelte",
      "vite/client"
    ]
  }
}
